#!/usr/bin/env bash
# A stand-in for gh in the helper tests. It logs every call to
# $STUB_LOG (arguments, then any JSON body sent with --input -) and
# replays responses recorded from the real API (tests/fixtures/,
# recorded 2026-11-11 from this repository).
fx="$(cd "$(dirname "$0")/../fixtures" && pwd)"
args=("$@")
printf 'gh %s\n' "$*" >> "$STUB_LOG"

jq_filter="" body=""
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    --jq) jq_filter="${args[$((i + 1))]}" ;;
    --input) body=$(cat); printf '  body %s\n' "$body" >> "$STUB_LOG" ;;
  esac
done

# A recorded GET response, found by its path with / turned into _ and
# the query dropped (tests/fixtures/api/).
recorded=""
if [ "$1" = api ] && [[ " $* " != *" -X "* ]]; then
  for a in "${args[@]}"; do
    case "$a" in
      repos/*)
        f="$fx/api/$(printf '%s' "$a" | sed 's/?.*//; s#/#_#g').json"
        [ -f "$f" ] && recorded="$f"
        break ;;
    esac
  done
fi

if [ -n "$recorded" ]; then
  out=$(cat "$recorded")
else
case "$1 $2" in
  "repo view")
    out='{"nameWithOwner":"north-foster-farm/nff-agentic-workflow"}' ;;
  "api "*)
    case "$*" in
      *milestones*) out=$(cat "$fx/milestones.json") ;;
      *"-X DELETE"*|*"--silent"*) out="" ;;
      *) out=$(cat "$fx/issue.json") ;;
    esac ;;
  *) out="" ;;
esac
fi

if [ -n "$out" ] && [ -n "$jq_filter" ]; then
  printf '%s' "$out" | jq -r "$jq_filter"
elif [ -n "$out" ] && [[ " $* " != *" --silent "* ]]; then
  printf '%s\n' "$out"
fi
